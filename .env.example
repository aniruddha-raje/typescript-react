# Credentials the mock login accepts. Copy this file to `.env` to override
# the admin/admin defaults.
#
# VITE_-prefixed variables are inlined into the client bundle at build time,
# so these are visible to anyone who opens the app. That is acceptable for a
# demo login and is not a substitute for real authentication.
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin
